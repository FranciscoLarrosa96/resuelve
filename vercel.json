{
  "functions": {
    "api/public-profile.ts": {
      "includeFiles": "dist/resuelve/browser/index.csr.html"
    }
  },
  "rewrites": [
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|[Pp]review|facebookexternalhit|WhatsApp|[Ee]mbedly).*"
        }
      ],
      "destination": "/api/public-profile?slug=:slug"
    },
    { "source": "/p/:slug", "destination": "/index.csr.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
