# ---------------------------------------------------------------
# Resuelve API — variables de entorno
# Copiá este archivo a `.env` para desarrollo. Nunca subas `.env`.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL. En Render: usar la "Internal Database URL" del servicio.
# Ej. local, solo desarrollo/test (compose.yaml):
DATABASE_URL=postgresql://resuelve:resuelve_local@localhost:5433/resuelve_test
# true si la conexión exige TLS (Render "External Database URL", la mayoría de hostings).
DATABASE_SSL=false

# Secretos JWT: strings largos y aleatorios, distintos entre sí.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens (formato ms: 15m, 1h, 30d…)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Reintento legítimo de un refresh token recién rotado (recarga, pestaña duplicada). 0–60, default 10.
REFRESH_REUSE_GRACE_SECONDS=10

# Origen(es) permitidos por CORS, separados por coma.
FRONTEND_URL=http://localhost:4200

# Nivel de logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Documento OPCIONAL de matrícula (almacenamiento PRIVADO en Cloudinary). Sin estas
# tres solo se envía el número (la subida responde 503). Nunca exponer el secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Planes (todo opcional). Solicitudes distintas que un FREE presupuesta por mes
# (recibir solicitudes no tiene tope). Default 5; 0 = sin límite.
FREE_MONTHLY_QUOTE_LIMIT=5
FIRST_SUCCESS_TRIAL_ENABLED=true
# Acceso anticipado de PRO/primer éxito en discovery. Free recibe oportunidades
# generales después de esta demora; targeted mantiene entrega inmediata.
PRO_EARLY_OPPORTUNITIES=true
FREE_OPPORTUNITY_DELAY_MINUTES=30
URGENT_FREE_OPPORTUNITY_DELAY_MINUTES=30
# Tope de presupuestos PENDING vigentes + ACCEPTED por solicitud.
MAX_ACTIVE_QUOTES_PER_REQUEST=5
# Correlaciona exposición destacada, visita al perfil y solicitud sin PII.
PRO_ATTRIBUTION=true
# Safety valves (vacías = sin límite; reservadas para abuso futuro)
FIRST_SUCCESS_TRIAL_MAX_DAYS=
FIRST_SUCCESS_TRIAL_MAX_OPPORTUNITIES=
# Espacios "Destacado" (PRO) por búsqueda y resultados necesarios para abrir cada uno.
FEATURED_SLOTS=2
FEATURED_RESULTS_PER_SLOT=8
# Precio mensual de PRO en pesos (lo cobra Mercado Pago si BILLING_PROVIDER=mercadopago). Default 15000.
PRO_MONTHLY_PRICE_ARS=15000

# Billing de PRO (ver backend/README.md → "Billing PRO con Mercado Pago").
# none (default) = no se contrata online · mercadopago = cobro real · fake = checkout falso (solo dev/Playwright).
BILLING_PROVIDER=none
# test = credenciales/cuentas de prueba de Mercado Pago · prod = reales (solo con NODE_ENV=production).
MP_ENV=test
# Access Token de la aplicación (Tus integraciones → Credenciales). Solo backend; nunca se loguea.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → Webhooks) para validar x-signature.
MP_WEBHOOK_SECRET=
# Adónde vuelve Mercado Pago después de autorizar.
MP_BACK_URL=http://localhost:4200/pro/plan/resultado
# Solo MP_ENV=test: email del comprador de prueba (Mercado Pago exige que coincida).
# MP_TEST_PAYER_EMAIL=
# MP_TIMEOUT_MS=10000
# Días con PRO tras un cobro rechazado mientras Mercado Pago reintenta.
BILLING_GRACE_DAYS=10
# Reconciliación automática (min; 0 = apagada) y vigencia de un checkout pendiente (h).
# BILLING_RECONCILE_INTERVAL_MINUTES=60
# BILLING_PENDING_TTL_HOURS=24
# Checkout y cancelación por minuto y por IP.
# THROTTLE_BILLING_LIMIT=6

# Solo para `npm run test:e2e` (se borra y recrea en cada corrida).
TEST_DATABASE_URL=postgresql://resuelve:resuelve_local@localhost:5433/resuelve_test

# Direcciones de "¿Dónde es el trabajo?" (opcional). none = dirección a mano + barrios.
# LOCATION_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
# Key pública solo para Maps JavaScript API; restringir por HTTP referrer y API en Google Cloud.
# GOOGLE_MAPS_BROWSER_API_KEY=
# THROTTLE_LOCATION_LIMIT=30

# Verificación de email por código: apagada por defecto (el registro crea la
# cuenta directo y nada exige email verificado). true = registro pendiente con
# código de 6 dígitos (necesita un SMTP que funcione; Render Free bloquea SMTP).
# EMAIL_VERIFICATION_ENABLED=false
# Verificación real de email (código de 6 dígitos). Sin SMTP_HOST no se envía
# nada (el registro no rompe, pero nadie puede verificar hasta configurarlo).
# Gmail sirve para desarrollo con una App Password (nunca la contraseña normal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=app-password-de-16-caracteres
# EMAIL_FROM="Resuelve <no-responder@resuelve.dev>"
# EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
# THROTTLE_VERIFICATION_LIMIT=10
